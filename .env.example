# 0 = laptop/USB webcam. RTSP example:
# CAMERA_URL=rtsp://username:password@192.168.1.50:554/stream1
CAMERA_URL=0

# nano is the safest first test for a 6 GB RTX 3050.
# Valid values: nano, small, medium, large
MODEL_SIZE=nano
CONFIDENCE=0.40
TARGET_FPS=10

# Empty means show every detected COCO class.
# Example: CLASS_FILTER=person,cup,bowl,bottle
CLASS_FILTER=

SHOW_WINDOW=true
DISPLAY_WIDTH=1280
DISPLAY_HEIGHT=800
MAX_DETECTIONS=50
RECONNECT_SECONDS=3
RTSP_TRANSPORT=tcp
CAMERA_OPEN_TIMEOUT_MS=5000
CAMERA_READ_TIMEOUT_MS=5000
SNAPSHOT_DIR=artifacts/snapshots

# Object-counter defaults. Empty COUNT_LINE draws a vertical line at frame center.
# Custom line format: x1,y1,x2,y2 in original camera pixels.
COUNT_LINE=
# Empty means count every class recognized by the pretrained model.
COUNT_CLASSES=
MINIMUM_CROSSING_FRAMES=2

# Scoop-model development workbench. Leave checkpoint empty until a custom
# RF-DETR model has been trained; the workbench then runs in COCO preview mode.
SCOOP_CHECKPOINT=
SCOOP_CONFIDENCE=0.35
SCOOP_ASSOCIATION_DISTANCE=140
WORKBENCH_SESSION_DIR=artifacts/workbench
